<Window x:Class="SwitcherRecordCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SwitcherRecordCSharp"
        mc:Ignorable="d"
        Title="Switcher Record" Height="auto" Width="400"  SizeToContent="WidthAndHeight" Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock x:Name="statusBarRecordStatus">Not Connected</TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="statusBarItemTimecode" HorizontalAlignment="Center">00:00:00</TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock x:Name="statusBarRecordingTimeAvailable">0 min 0 sec</TextBlock>
            </StatusBarItem>
        </StatusBar>
        <StackPanel HorizontalAlignment="Left" Height="auto" VerticalAlignment="Top" Width="auto">
            <GroupBox Header="Switcher">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="IP Address:" VerticalAlignment="Center" Margin="3"/>
                    <Border x:Name="borderIPAddr" Grid.Column="1" BorderBrush="#FFABADB3" BorderThickness="1" Margin="3" MouseEnter="BorderIPAddr_MouseEnter" MouseLeave="BorderIPAddr_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="textBoxIPAddr1" HorizontalAlignment="Center" VerticalAlignment="Bottom"  TextAlignment="Center" Width="30" Margin="3,3,0,3" BorderBrush="{x:Null}" SelectionBrush="Transparent" PreviewTextInput="TextBoxIPAddr1_PreviewTextInput"/>
                            <Label Content="." Margin="0" Grid.Column="1"/>
                            <TextBox x:Name="textBoxIPAddr2" HorizontalAlignment="Center" VerticalAlignment="Bottom"  TextAlignment="Center" Width="30" Margin="0,3,0,3" Grid.Column="2" BorderBrush="{x:Null}" SelectionBrush="Transparent" PreviewTextInput="TextBoxIPAddr2_PreviewTextInput"/>
                            <Label Content="." Margin="0" Grid.Column="3"/>
                            <TextBox x:Name="textBoxIPAddr3" HorizontalAlignment="Center" VerticalAlignment="Bottom"  TextAlignment="Center" Width="30" Margin="0,3,0,3" Grid.Column="4" BorderBrush="{x:Null}" SelectionBrush="Transparent" PreviewTextInput="TextBoxIPAddr3_PreviewTextInput"/>
                            <Label Content="." Margin="0" Grid.Column="5"/>
                            <TextBox x:Name="textBoxIPAddr4" HorizontalAlignment="Center" VerticalAlignment="Bottom"  TextAlignment="Center" Width="30" Margin="0,3,3,3" Grid.Column="6" BorderBrush="{x:Null}" SelectionBrush="Transparent" PreviewTextInput="TextBoxIPAddr4_PreviewTextInput"/>
                        </Grid>
                    </Border>
                    <Button x:Name="buttonConnect" Content="Connect" Margin="3" Padding="3" Grid.Column="2" MinWidth="75" Click="ButtonConnect_Click"/>
                    <Label Content="Product Name:" Grid.Row="1" Grid.Column="0" Margin="3"/>
                    <TextBox x:Name="textBoxProductName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="3" Padding="3" IsReadOnly="True"/>
                </Grid>
            </GroupBox>
            <GroupBox x:Name="groupBoxRecordSettings" Header="Record Settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="File Basename:" Margin="3"/>
                    <TextBox x:Name="textBoxFileBasename" Grid.Column="1" Margin="3" Padding="3" LostFocus="TextBoxFileBasename_LostFocus" />
                    <CheckBox x:Name="checkBoxRecordInAllCameras" Content="Record in all Cameras" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="3" Click="CheckBoxRecordInAllCameras_Click"/>
                    <CheckBox x:Name="checkBoxISORecording" Content="ISO Recording" VerticalAlignment="Center"  Grid.Row="2" Grid.Column="1" Margin="3" Visibility="Collapsed" Click="CheckBoxISORecording_Click"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Disks">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Disk 1:" Margin="3" Padding="3"/>
                    <ComboBox x:Name="comboBoxDisk1" Grid.Column="1" Margin="3" SelectionChanged="ComboBoxDisk1_SelectionChanged" ItemsSource="{Binding RecordDiskIdCollection, Mode=OneWay}"  DisplayMemberPath="Value" SelectedValuePath="Key"/>
                    <TextBox x:Name="textBoxDisk1Status" Grid.Column="2" Margin="3" Padding="3" IsReadOnly="True"/>
                    <TextBox x:Name="textBoxDisk1Duration" Grid.Column="3" Margin="3" Padding="3"  IsReadOnly="True"/>
                    <Label Content="Disk 2:" Margin="3"  Padding="3" Grid.Row="1"/>
                    <ComboBox x:Name="comboBoxDisk2" Grid.Row="1" Margin="3" Grid.Column="1" SelectionChanged="ComboBoxDisk2_SelectionChanged" ItemsSource="{Binding RecordDiskIdCollection, Mode=OneWay}" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                    <TextBox x:Name="textBoxDisk2Status" Grid.Row="1" Grid.Column="2" Margin="3" Padding="3" IsReadOnly="True"/>
                    <TextBox x:Name="textBoxDisk2Duration" Grid.Row="1" Grid.Column="3" Margin="3" Padding="3" IsReadOnly="True"/>
                </Grid>
            </GroupBox>
            <UniformGrid Margin="20,10" Rows="1">
                <Button x:Name="buttonStartStopRecording" Content="Start Recording" Margin="3" Click="ButtonStartStopRecording_Click" />
                <Button x:Name="buttonSwitchDisk" Content="Switch Disk" Grid.Column="1" Margin="3" Click="ButtonSwitchDisk_Click"/>
            </UniformGrid>
        </StackPanel>
    </DockPanel>

</Window>
